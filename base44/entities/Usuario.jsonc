{
  "name": "Usuario",
  "type": "object",
  "properties": {
    "rol": {
      "type": "string",
      "enum": [
        "dueno",
        "cuidador",
        "admin"
      ],
      "default": "dueno"
    },
    "nombre": {
      "type": "string"
    },
    "apellido": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "ciudad": {
      "type": "string"
    },
    "zona": {
      "type": "string"
    },
    "foto_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "perfil_completo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "rol"
  ]
}